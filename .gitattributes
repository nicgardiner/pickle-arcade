# Line-ending policy (applied 2026-09-06 as its own commit, right after v1.1.4).
# Text is stored LF in the repo; source that the Linux Pages build reads is LF on
# checkout everywhere; Windows-only scripts keep CRLF; binaries are never touched.

* text=auto

*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.svg   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.rules text eol=lf

# third-party engines in vendor/ stay byte-identical to the published files
vendor/** -text

# partners' untouched builds stay byte-identical to what they sent (CRLF and all, so a
# sha256 against their drop matches); each patch.mjs normalises CRLF itself, so the
# generated root files are the same on Windows and on the Linux CI
partners/*/*/source/** -text

*.vbs   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

*.png   binary
*.ico   binary
*.jpg   binary
*.gif   binary
*.zip   binary
*.exe   binary
*.mp3   binary
*.ogg   binary
*.wav   binary
*.woff  binary
*.woff2 binary
